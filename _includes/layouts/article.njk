            <li><a href="/practice-areas/#land">Land &amp; Environment</a></li>
            <li><a href="/practice-areas/#employment">Employment</a></li>
            <li><a href="/practice-areas/#criminal">Criminal Defence</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h4>Contact</h4>
          <div class="footer__contact-item">
            <svg class="footer__contact-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Bomet &amp; Nairobi, Kenya</span>
          </div>
          <div class="footer__contact-item">
