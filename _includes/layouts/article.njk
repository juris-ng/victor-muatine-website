<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ excerpt if excerpt else description }}" />
  <title>{{ title }} | Mugumya & Co Advocates</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/style.css" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href="/insights/{{ page.fileSlug }}/" />

  <!-- OpenGraph -->
  <meta property="og:site_name"   content="Mugumya &amp; Co Advocates" />
  <meta property="og:title"       content="{{ title }} | Mugumya &amp; Co Advocates" />
  <meta property="og:description" content="{{ excerpt if excerpt else title }}" />
  <meta property="og:url"         content="/insights/{{ page.fileSlug }}/" />
  <meta property="og:image"       content="{{ featuredImage if featuredImage else 'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=1200&q=80' }}" />
  <meta property="og:locale"      content="en_KE" />
  <meta name="twitter:card"       content="summary_large_image" />
  <meta name="twitter:site"       content="@MugumyaLegal" />
  <meta name="twitter:title"      content="{{ title }}" />
  <meta name="twitter:description" content="{{ excerpt if excerpt else description }}" />
  <meta name="twitter:image"      content="{{ featuredImage if featuredImage else 'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=1200&q=80' }}" />

  <!-- Netlify Identity Widget -->
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

  <style>
    /* ─── ARTICLE HERO ─── */
    .article-hero {
      background: var(--color-surface-2);
      padding-top: calc(68px + clamp(var(--space-12), 8vw, var(--space-20)));
      padding-bottom: clamp(var(--space-12), 6vw, var(--space-20));
      position: relative; overflow: hidden;
    }
    .article-hero::before {
      content:''; position:absolute; left:0;top:0;bottom:0;width:4px;
      background:linear-gradient(to bottom,transparent,var(--color-accent),transparent);
    }
    .article-hero__meta {
      display:flex;align-items:center;gap:var(--space-3);
      flex-wrap:wrap;margin-bottom:var(--space-6);
    }
    .article-hero__category {
      font-size:var(--text-xs);font-weight:700;letter-spacing:0.12em;
      text-transform:uppercase;color:var(--color-accent);
    }
    .article-hero__date {
      font-size:var(--text-xs);color:var(--color-text-faint);
    }
    .article-hero__dot {
      width:3px;height:3px;border-radius:50%;
      background:rgba(255,255,255,0.25);
    }
    .article-hero__title {
      font-family:var(--font-display);
      font-size:clamp(1.8rem, 1rem + 3vw, 3.5rem);
      font-weight:400;color:#fff;line-height:1.08;
      margin-bottom:var(--space-6);max-width:22ch;
    }
    .article-hero__title em { font-style:italic;color:var(--color-accent); }
    .article-hero__excerpt {
      font-size:var(--text-lg);color:var(--color-text-faint);
      max-width:55ch;line-height:1.75;
    }
    .article-hero__author {
      display:flex;align-items:center;gap:var(--space-3);
      margin-top:var(--space-8);
    }
    .article-hero__avatar {
      width:40px;height:40px;border-radius:50%;
      background:rgba(201,149,42,0.2);border:1.5px solid var(--color-accent);
      display:flex;align-items:center;justify-content:center;
      font-family:var(--font-display);font-size:var(--text-sm);
      color:var(--color-accent);font-weight:600;
    }
    .article-hero__author-name {
      font-size:var(--text-sm);font-weight:600;color:var(--color-text);
    }
    .article-hero__read-time {
      font-size:var(--text-xs);color:var(--color-text-faint);
    }

    /* ─── FEATURED IMAGE ─── */
    .article-featured-image {
      width:100%;
      max-height:520px;
      object-fit:cover;
      display:block;
    }

    /* ─── ARTICLE LAYOUT ─── */
    .article-layout {
      display:grid;
      grid-template-columns: 1fr min(72ch, 100%) 1fr;
      padding-block: clamp(var(--space-12), 8vw, var(--space-20));
      gap:0 var(--space-8);
    }
    .article-layout > * {
      grid-column: 2;
    }

    /* ─── ARTICLE BODY ─── */
    .article-body {
      font-size:var(--text-base);
      line-height:1.85;
      color:var(--color-text);
    }
    .article-body h2 {
      font-family:var(--font-display);
      font-size:var(--text-xl);
      font-weight:400;
      color:var(--color-text);
      margin-top:var(--space-12);
      margin-bottom:var(--space-4);
      line-height:1.15;
    }
    .article-body h3 {
      font-size:var(--text-lg);
      font-weight:700;
      color:var(--color-text);
      margin-top:var(--space-8);
      margin-bottom:var(--space-3);
    }
    .article-body p {
      margin-bottom:var(--space-6);
      max-width:72ch;
    }
    .article-body ul, .article-body ol {
      margin-bottom:var(--space-6);
      padding-left:var(--space-6);
    }
    .article-body li {
      margin-bottom:var(--space-2);
      line-height:1.75;
    }
    .article-body blockquote {
      border-left:3px solid var(--color-accent);
      padding:var(--space-4) var(--space-6);
      margin:var(--space-8) 0;
      background:rgba(201,149,42,0.05);
      border-radius:0 var(--radius-lg) var(--radius-lg) 0;
    }
    .article-body blockquote p {
      font-family:var(--font-display);
      font-size:var(--text-lg);
      font-style:italic;
      color:var(--color-text);
      margin-bottom:0;
    }
    .article-body a {
      color:var(--color-accent);
      text-decoration:underline;
      text-underline-offset:3px;
    }
    .article-body a:hover { opacity:0.8; }
    .article-body strong { font-weight:700;color:var(--color-text); }
    .article-body hr {
      border:none;
      border-top:1px solid var(--color-border);
      margin:var(--space-10) 0;
    }

    /* ─── ARTICLE FOOTER / TAGS ─── */
    .article-footer {
      grid-column:2;
      border-top:1px solid var(--color-border);
      padding-top:var(--space-8);
      margin-top:var(--space-8);
      display:flex;
      align-items:center;
      justify-content:space-between;
      flex-wrap:wrap;
      gap:var(--space-4);
    }
    .article-tags {
      display:flex;gap:var(--space-2);flex-wrap:wrap;
    }
    .article-tag {
      font-size:var(--text-xs);font-weight:700;
      letter-spacing:0.08em;text-transform:uppercase;
      padding:var(--space-1) var(--space-3);
      background:rgba(201,149,42,0.08);
      border:1px solid rgba(201,149,42,0.2);
      border-radius:var(--radius-full);
      color:var(--color-accent);
    }

    /* ─── BACK LINK ─── */
    .back-link {
      display:inline-flex;align-items:center;gap:var(--space-2);
      font-size:var(--text-sm);font-weight:600;color:var(--color-text-muted);
      margin-bottom:var(--space-6);
    }
    .back-link:hover { color:var(--color-accent); }

    /* ─── CTA BOX ─── */
    .article-cta {
      grid-column:2;
      background: var(--color-surface-2);
      border-radius:var(--radius-xl);
      padding:clamp(var(--space-8), 5vw, var(--space-12));
      margin-top:var(--space-12);
      text-align:center;
    }
    .article-cta h3 {
      font-family:var(--font-display);
      font-size:var(--text-xl);
      color:#fff;font-weight:400;
      margin-bottom:var(--space-3);
    }
    .article-cta p {
      color:var(--color-text-muted);
      font-size:var(--text-base);
      max-width:44ch;margin-inline:auto;
      margin-bottom:var(--space-6);
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 768px) {
      .article-layout {
        grid-template-columns: var(--space-4) 1fr var(--space-4);
      }
      .article-footer {
        flex-direction:column;align-items:flex-start;
      }
    }
  </style>
</head>
<body>

  <a href="#main" class="sr-only skip-link">Skip to main content</a>

  <!-- NAVBAR -->
  <header class="navbar" id="navbar">
    <div class="container navbar__inner">
      <a href="/index.html" class="navbar__logo" aria-label="Mugumya &amp; Co Advocates â€” Home">
