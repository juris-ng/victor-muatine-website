          <span class="brand-subtitle">ADVOCATES</span>
        </div>
      </a>
        <p class="footer__tagline">Fearless Advocacy. Uncompromising Integrity.</p>
      </div>

      <div class="footer__col">
        <h3 class="footer__heading">Navigation</h3>
        <ul class="footer__links">
          <li><a href="/index.html">Home</a></li>
          <li><a href="/about.html">About Firm</a></li>
        <a href="/practice-areas/">Practice Areas</a>
        <a href="/team/">Our Team</a>
        <a href="/insights/" aria-current="page">Insights</a>
        <a href="/contact/">Contact</a>
      </nav>
      <div class="navbar__actions">
        <button class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
        <a href="/contact/" class="btn btn-accent">Book Consultation</a>
        <button class="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    <a href="/index.html">Home</a>
    <a href="/about/">About</a>
    <a href="/practice-areas/">Practice Areas</a>
    <a href="/team/">Our Team</a>
    <a href="/insights/" aria-current="page">Insights</a>
    <a href="/contact/">Contact</a>
    <a href="/contact/" class="btn btn-accent" style="margin-top:var(--space-6);justify-content:center;">Book Consultation</a>
  </nav>

  <main id="main">

    <!-- ARTICLE HERO -->
    <section class="article-hero" aria-label="Article header">
      <div class="container">
        <div class="article-hero__meta">
          <span class="article-hero__category">{{ category if category else "Insights" }}</span>
          <span class="article-hero__dot" aria-hidden="true"></span>
          <time class="article-hero__date" datetime="{{ date | htmlDateString if date }}">
            {{ date | postDate if date }}
          </time>
        </div>
        <h1 class="article-hero__title">{{ title }}</h1>
        {% if excerpt %}
        <p class="article-hero__excerpt">{{ excerpt }}</p>
        {% endif %}
        <div class="article-hero__author">
          <div class="article-hero__avatar" aria-hidden="true">MC</div>
          <div class="article-hero__author-info">
            <p class="article-hero__author-name">{{ author if author else "Advocate Mugumya" }}</p>
            <p class="article-hero__read-time">{{ readTime if readTime else "5 min read" }}</p>
          </div>
        </div>
      </div>
    </section>

    {% if featuredImage %}
    <img
      src="{{ featuredImage }}"
      alt="{{ title }}"
      class="article-featured-image"
      width="1200" height="520"
      loading="eager"
    />
    {% endif %}

    <!-- ARTICLE CONTENT -->
    <div class="article-layout">

      <a href="/insights/" class="back-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Back to Insights
      </a>

      <article class="article-body" aria-label="Article content">
        {{ content | safe }}
      </article>

      {% if tags %}
      <footer class="article-footer">
        <div class="article-tags" aria-label="Article tags">
          {% for tag in tags %}
            {% if tag != "articles" %}
            <span class="article-tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
      </footer>
      {% endif %}

      <!-- CTA BOX -->
      <div class="article-cta">
        <h3>Need legal advice on this topic?</h3>
        <p>Our advocates are ready to help you navigate your specific situation — confidentially and without obligation.</p>
        <a href="/contact/" class="btn btn-accent">Book a Free Consultation</a>
      </div>

    </div>

  </main>

  <!-- FOOTER -->
  <footer class="footer" aria-label="Site footer">
